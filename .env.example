# ---------------------------------------------------------------------
# Server-side only. Read by the API functions and never exposed to the
# browser — note the absence of any VITE_ prefix, which is what would
# make Vite inline them into the bundle.
# ---------------------------------------------------------------------

# Neon. Use the POOLED connection string (…-pooler.…) for the app: a
# serverless function opens a connection per invocation.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Migrations in db/*.sql go over the DIRECT endpoint instead (the same
# host without `-pooler`). They are schema changes, not concurrent traffic.

# Signs session tokens. 32+ characters, and the server refuses to start
# a session without it. Rotating it signs everyone out immediately.
JWT_SECRET=change-me-to-at-least-32-random-characters

# Optional
SESSION_TTL_SECONDS=43200   # 12h; still capped by the tenant's expiry
PGPOOL_MAX=3                # keep small: serverless opens many instances
SESSION_IDLE_SECONDS=300    # "log out after 5 minutes of inactivity"

# Seals two-step sign-in secrets at rest. Falls back to JWT_SECRET; set it
# separately so rotating sessions does not invalidate every enrolment.
# MFA_KEY=

# The nightly people sync (/cron/directory-sync). Vercel Cron sends it.
# CRON_SECRET=

# LDAP / Active Directory, for the one organisation named by LDAP_TENANT.
# Attribute names and filters default to OpenLDAP's; see src/server/ldap.ts.
# LDAP_URL=ldaps://dc.example.com:636
# LDAP_BIND_DN=cn=ams,ou=services,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=ou=people,dc=example,dc=com
# LDAP_TENANT=organisation-slug

# Email. Without SMTP_URL every email is still written and kept in the
# email log as "captured"; with it, it is delivered.
# SMTP_URL=smtp://user:password@mail.example.com:587
# MAIL_FROM="Approvals <approvals@example.com>"
# APP_URL=https://approvals.example.com   # where links in emails point
