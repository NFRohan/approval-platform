{
  "name": "Admin Services Portal",
  "short_name": "Approvals",
  "description": "Raise requests, approve them and follow them, from your phone.",
  "id": "/",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FAFAFA",
  "theme_color": "#4F46E5",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Pending approvals", "short_name": "Approvals", "url": "/approvals?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Raise a request", "short_name": "Raise", "url": "/forms?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My submissions", "short_name": "Requests", "url": "/submissions?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
