{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "vite build",
  "outputDirectory": "dist/client",
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/cron/directory-sync",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/cron/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/cron/daily",
      "schedule": "0 2 * * *"
    }
  ]
}
